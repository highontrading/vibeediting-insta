# Copy this file to .env and fill in the values. NEVER commit .env.
# See docs/INSTAGRAM_SETUP.md for how to get each value.

# "instagram" = Instagram API with Instagram Login (graph.instagram.com) — recommended, no Facebook Page needed.
# "facebook"  = Instagram API with Facebook Login (graph.facebook.com) — needs a linked Facebook Page.
IG_LOGIN_TYPE=instagram

# Long-lived access token (valid ~60 days; refresh with `npm run ig:refresh-token`).
IG_ACCESS_TOKEN=

# Your Instagram professional account ID (numeric). `npm run ig:check` prints it if you leave it empty.
IG_USER_ID=

# Graph API version.
IG_API_VERSION=v25.0
